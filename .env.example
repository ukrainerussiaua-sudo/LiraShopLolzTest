BOT_TOKEN=
BOT_USERNAME=         # без @, username вашего бота (нужен для реф-ссылок)
ADMIN_IDS=            # через запятую: 12345,67890  (эти люди получают заявки, чеки, уведомления)

SUPABASE_URL=
SUPABASE_KEY=         # ключ service_role

# Lolz Market: lolz.live -> настройки -> API (права read + market)
LOLZ_TOKEN=
LOLZ_SPAM=no
# авторег + саморег. ВАЖНО: саморег у Lolz называется self_registration (не self_registered).
LOLZ_ORIGINS=autoreg,self_registration
# Стартовый курс: сколько ₴ стоит 1 ₽ (цены Lolz в рублях). Потом меняется в админке: «Себестоимость → Курс Lolz»
LOLZ_RUB_TO_UAH=0.46

# ── Пополнение ──
# Перевод на карту: можно задать тут или в админке («Реквизиты карты»; админка важнее)
CARD_NUMBER=
CARD_HOLDER=
CARD_BANK=
MIN_TOPUP=50
# Автопроверка перевода на карту через Monobank Open API (застосунок Monobank → Ще → Інше → Monobank Open API).
# Карта выше должна принадлежать этому токену. Пусто = ручной режим (чек + подтверждение админом).
MONOBANK_API_TOKEN=
MONOBANK_ACCOUNT_ID=0
MONOBANK_PAYMENT_TTL_MIN=30
# Crypto Bot (счёт выставляется в UAH; запасной курс USDT на случай, если UAH не принят)
CRYPTO_PAY_TOKEN=
CRYPTO_UAH_TO_USDT_FALLBACK=41.5
# Реферальный бонус пригласившему за покупку приглашённого, ₴
REF_BONUS=2

# Необязательно: ссылки на документы. Пусто = строки в боте не показываются
# DOC_RULES_URL=
# DOC_PRIVACY_URL=
# DOC_TERMS_URL=

# ── Горячий TON-кошелёк бота (нужен для: Stars/Premium через Fragment, продажи TON клиентам; им же можно принимать пополнения) ──
# Войдите на fragment.com через Telegram, подключите этот кошелёк (импорт seed в Tonkeeper), скопируйте cookies (DevTools → Application → Cookies).
FRAGMENT_STEL_SSID=
FRAGMENT_STEL_TOKEN=
FRAGMENT_STEL_TON_TOKEN=
FRAGMENT_STEL_DT=-180
FRAGMENT_USER_AGENT=
# 24 слова через пробел, кошелёк v4R2. Держите там немного TON (с него уходит TON клиентам и в Fragment)!
TON_MNEMONIC=
TON_WALLET_VERSION=v4r2
TONCENTER_API_KEY=    # желательно: бесплатный ключ @tonapibot, иначе toncenter режет до 1 запроса/сек
# Как часто бот сам ищет TON-пополнения, сек
TON_DEPOSIT_POLL_S=30
# Курс TON с сайта (CoinGecko). Ключ необязателен (бесплатный Demo-ключ — выше лимиты)
COINGECKO_API_KEY=
TON_RATE_REFRESH_S=60
TON_RATE_MAX_AGE_S=900
